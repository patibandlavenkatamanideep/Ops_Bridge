        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "opsbridge-prometheus"
          },
          "expr": "sum by (status_class) (rate(opsbridge_http_requests_total[5m]))",
          "legendFormat": "{{status_class}}"
