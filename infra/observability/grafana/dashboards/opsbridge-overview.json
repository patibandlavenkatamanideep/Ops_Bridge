    {
      "id": 2,
      "type": "stat",
      "title": "Scrape targets up",
      "description": "1 = Prometheus can scrape the process. Runbook: docs/operations.md#api-or-worker-down",
      "datasource": {
        "type": "prometheus",
        "uid": "opsbridge-prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 1
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "opsbridge-prometheus"
          },
          "expr": "up{job=~\"opsbridge-.*\"}",
          "legendFormat": "{{job}}"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none"
      }
    },
