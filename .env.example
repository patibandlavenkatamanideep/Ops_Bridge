# OpsBridge local configuration template.
# `make setup` copies this to .env and replaces every __GENERATE__ value with a random
# development-only secret. It never overwrites an existing .env.
# Values here are placeholders. Production configuration rejects the dev profile.

OPSBRIDGE_ENV=development

# PostgreSQL (container on host port 5433; the bootstrap superuser is only used by init scripts)
POSTGRES_SUPERUSER_PASSWORD=__GENERATE__
OPSBRIDGE_DB_HOST=localhost
OPSBRIDGE_DB_PORT=5433
OPSBRIDGE_DB_NAME=opsbridge
OPSBRIDGE_DB_MIGRATOR_PASSWORD=__GENERATE__
OPSBRIDGE_DB_APP_PASSWORD=__GENERATE__
OPSBRIDGE_DB_WORKER_PASSWORD=__GENERATE__
OPSBRIDGE_DB_MCP_PASSWORD=__GENERATE__
KEYCLOAK_DB_PASSWORD=__GENERATE__

# Keycloak (local development profile; admin console at http://localhost:8081)
KEYCLOAK_ADMIN_PASSWORD=__GENERATE__
OPSBRIDGE_OIDC_ISSUER=http://localhost:8081/realms/opsbridge
OPSBRIDGE_OIDC_CLIENT_ID=opsbridge-web
OPSBRIDGE_OIDC_CLIENT_SECRET=__GENERATE__
OPSBRIDGE_WORKER_CLIENT_SECRET=__GENERATE__
# Password shared by the synthetic demo users in the local realm. Development only.
OPSBRIDGE_DEMO_USER_PASSWORD=__GENERATE__

# Web application
OPSBRIDGE_PUBLIC_URL=http://localhost:5173
OPSBRIDGE_SESSION_SECRET=__GENERATE__
OPSBRIDGE_DELEGATION_KEY_PATH=var/keys/delegation_ed25519.pem
# Staging/production: supply the Ed25519 private key (PEM) from a secret store instead of a
# file; it is never written to disk, and production never generates a key.
# OPSBRIDGE_DELEGATION_PRIVATE_KEY=
# Services that only VERIFY delegations (the MCP services) get the public key(s) instead,
# never the private key: PEM strings as a JSON list, or a file of PEM blocks. Several keys
# are accepted while the signing key rotates. Development derives one from the key file.
# OPSBRIDGE_DELEGATION_PUBLIC_KEYS=[]
# OPSBRIDGE_DELEGATION_PUBLIC_KEY_PATH=var/keys/delegation_ed25519.pub.pem
# Requests per signed-in user per minute. The browser tests sign in as the same few demo
# users dozens of times a minute, which the deployed default (240) is not sized for.
OPSBRIDGE_RATE_LIMIT_PER_MINUTE=1200

# Purchasing simulator (local stand-in for an external system). Fault-injection controls
# are for local testing only and are refused when OPSBRIDGE_ENV=production.
OPSBRIDGE_SIMULATOR_URL=http://localhost:8090
OPSBRIDGE_SIM_MASTER_SECRET=__GENERATE__
OPSBRIDGE_SIMULATOR_FAULT_CONTROLS=true

# Tool transport: "mcp" routes agent evidence search and task execution through the
# Records/Casework MCP services (dev stack runs them); "inprocess" calls services directly.
OPSBRIDGE_TOOL_TRANSPORT=mcp

# Model adapters. Default is the deterministic mock; live calls need explicit opt-in.
OPSBRIDGE_MODEL_MODE=mock
OPSBRIDGE_LIVE_MODEL_OPT_IN=false
OPSBRIDGE_LIVE_SPEND_CEILING_USD=0
ANTHROPIC_API_KEY=
OPSBRIDGE_ANTHROPIC_MODEL=
OLLAMA_BASE_URL=http://localhost:11434
OPSBRIDGE_OLLAMA_MODEL=

# GitHub sandbox connector (disabled unless all three are set and live writes are authorized)
OPSBRIDGE_GITHUB_SANDBOX_REPO=
OPSBRIDGE_GITHUB_TOKEN=
OPSBRIDGE_GITHUB_LIVE_WRITES_AUTHORIZED=false
# Further repositories a tenant's task connection may name (JSON list), and the secret a
# connection's credential reference names: OPSBRIDGE_CONNECTION_SECRET_<REF>=…
OPSBRIDGE_GITHUB_REPOSITORY_ALLOWLIST=[]
# Read purchasing records from exports (<dir>/<organization>/manifest.json and its files)
# instead of the simulator; empty means the simulator.
# OPSBRIDGE_PURCHASING_EXPORT_DIR=
# Which tenant, connector and repositories each credential reference may serve; a tenant can
# choose only references registered to it (JSON). Example:
# OPSBRIDGE_CONNECTION_CREDENTIALS={"acme-github": {"tenant": "acme", "connector": "github_issues", "repositories": ["acme/followups"]}}
OPSBRIDGE_CONNECTION_CREDENTIALS={}

# Grafana (make observability-up): anonymous read-only dashboards on localhost; the login form
# and basic auth are disabled, so this admin password is defence in depth only.
OPSBRIDGE_GRAFANA_ADMIN_PASSWORD=__GENERATE__
