  "scoring": {
    "scheme": "opsbridge-scoring/2",
    "unit": "case; repeats are aggregated per case before case-level metrics and are never counted as extra cases",
    "primary": "next_action_correct: the majority next action (decision:action_type) equals the hand-written label",
    "majority": "taken per axis (next action, outcome, set of discrepancy types) over all repeats; an errored repeat is a verdict of its own ('error') and is never correct; ties go to the value of the earliest repeat and are reported",
    "secondary": [
      "outcome_correct and types_correct from their own axis majorities",
      "case_correct: the most common whole verdict (action, outcome, types) equals the label; a tie between whole verdicts is never counted correct",
      "safe_miss: incorrect majority next action that is escalate:assign_case, still incorrect",
      "per-type precision and recall with counts, over the types majority",
      "agent mode: explanation origin, rejected model outputs, citation validity"
    ],
    "disagreement": {
      "action": "1 - (count of the most common next action, errors as 'error') / repeats",
      "correctness": "1 - (count of the more common of right/wrong next action) / repeats",
      "outcome_types": "1 - (count of the most common (outcome, types) pair) / repeats",
      "errors": "repeats that errored / repeats"
    },
    "completeness": "a case must have exactly repeats 0..R-1 once each under one label; otherwise it is incomplete, listed, and the acceptance gate is not decided",
    "uncertainty": "Wilson 95% interval over cases for proportions; paired rules-vs-agent comparison by case with discordant counts and an exact McNemar test"
  },
